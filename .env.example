# ============================================================
# VYUGAM 2.0 — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Google Apps Script ──────────────────────────────────────
# Deploy your Code.gs as a Web App (Extensions → Apps Script → Deploy)
# Set "Execute as: Me" and "Who has access: Anyone"
GAS_WEB_APP_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Shared secret between Vercel and Apps Script.
# Must match CONFIG.ADMIN_SECRET in Code.gs. Use a long random string.
GAS_ADMIN_SECRET=your_random_admin_secret_here_min_32_chars

# Must match CONFIG.COORD_SECRET in Code.gs. Use a different long random string.
GAS_COORD_SECRET=your_random_coord_secret_here_min_32_chars

# ── Admin Credentials ──────────────────────────────────────
# Username for the admin login panel at /admin
ADMIN_USERNAME=admin

# For development: plain password (do not use in production)
ADMIN_PASSWORD=your_dev_password_here

# For production: generate a bcrypt hash and use this instead of ADMIN_PASSWORD
# Run: node -e "const b=require('bcryptjs'); b.hash('YOUR_PASSWORD',12).then(h=>console.log(h))"
# ADMIN_PASSWORD_HASH=$2a$12$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── JWT Secrets ────────────────────────────────────────────
# Used for stateless session tokens (admin + coordinator cookies)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=your_random_admin_jwt_secret_here
COORDINATOR_JWT_SECRET=your_random_coordinator_jwt_secret_here

# ── Base URL ───────────────────────────────────────────────
# Your deployed Vercel URL (no trailing slash)
BASE_URL=https://your-site.vercel.app

# ── REMOVED (no longer needed) ────────────────────────────
# UPSTASH_REDIS_REST_URL     → replaced by Google Sheets
# UPSTASH_REDIS_REST_TOKEN   → replaced by Google Sheets
# BLOB_READ_WRITE_TOKEN       → replaced by Google Drive
# BLOB_STORE_ID               → replaced by Google Drive
# RESEND_API_KEY              → replaced by Gmail via Apps Script
# FROM_EMAIL                  → configured in Code.gs (EMAIL_FROM_NAME)
# SETUP_SECRET                → no longer needed (setup done in Sheets directly)
